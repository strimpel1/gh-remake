  <UserdefinedSymbols/>
  <LuaScript>-- Episode 6: an empty table with the command channel (lab/ce/ce.py, lab/ep06_cap.py).
local path = [[D:\AI\gh-remake\lab\ce\cmd.lua]]
local t = createTimer(nil, false)
t.Interval = 100
t.OnTimer = function()
  local f = io.open(path, "r")
  if f then
    local s = f:read("*a"); f:close(); os.remove(path)
    local fn, err = load(s); local ok, res
    if fn then ok, res = pcall(fn) else res = err end
    local o = io.open(path .. ".out", "w"); o:write(tostring(ok) .. " " .. tostring(res)); o:close()
  end
end
t.Enabled = true
</LuaScript>
